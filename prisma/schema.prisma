// Savoy Capital — the first schema in this repo (owner, 2026-08-24).
//
// It exists because the Deal Room needs somewhere to put a deal's NAME and a
// document's DESCRIPTION. R2 holds bytes and keys; neither of those is a byte,
// and R2's list call returns keys and sizes but not custom metadata, so a
// listing built on object metadata alone costs one request per file.
//
// Prisma 7: there is no `url` here. The connection string lives in
// `prisma.config.ts` for migrate, and the runtime client takes a driver adapter
// (`src/lib/db.ts`). That split is why codegen works in CI with no secrets.
//
// ## The fund dimension, and the FACTS.md contradiction it creates
//
// `FACTS.md` says Savoy Capital is ONE fund and that theAPlink's "what does
// adding client #27 cost?" is the wrong question here. This schema nonetheless
// carries a `Fund`, on the owner's explicit call (2026-08-24):
//
//   > "FundID - will denote the fund (if we grow later) / DealID - deal within
//   > the fund ... investors would be identified by fundID, and they would have
//   > access to all the deal info within the fundID"
//
// That is a deliberate override, not drift, and DECISIONS.md records it. The
// reasoning: a fund id costs one column now and a data migration later, and it
// is the natural authorization boundary for investors — the thing this product
// does not have yet and will need. **It is NOT multi-tenancy.** There is no
// tenancy extension, no per-model scoping middleware, and no `check:tenant-
// scoping` ratchet. One column, one relation, nothing enforced by machinery.
//
// ## What is deliberately NOT modelled
//
// Positions, marks and valuations. What an equity vs. debt position holds is
// the decision `STATE.md` records as blocked on a person, and guessing it here
// to have a fuller schema would mean the real one starts by undoing this.
// There is also no user table — Clerk owns identity, so `createdBy` and
// `uploadedBy` are Clerk user ids with no foreign key to point at.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Who a document is meant for. The audience decides the R2 key's OUTERMOST
/// segment, because that is what `src/lib/r2.ts`'s `isServableKey()` guards on.
enum Audience {
  MANAGEMENT
  INVESTOR
}

/// A fund. There is exactly one today and every deal belongs to it.
model Fund {
  id   Int    @id @default(autoincrement())
  name String

  /// Committed capital, in integer cents (owner, 2026-08-24: "fund size ($)").
  ///
  /// NULLABLE, and fund 1 predates the column: this repo may not invent a fund
  /// figure, so no migration backfilled one. It is set from the screen instead.
  ///
  /// **This column IS what the Portfolio chart renders** (owner, 2026-08-24:
  /// "lets tie the portfolio values to the values in fund and investments").
  /// It briefly was not — `src/content/fund-allocation.ts` held a second copy
  /// and the chart drew that one, so editing the fund size here changed nothing
  /// on screen. There is now one source. **Null means the chart has no fund
  /// size to divide by**, and Portfolio says so rather than drawing a split of
  /// an unknown total.
  ///
  /// **`BigInt`, not `Int`, and that is not premature.** A Postgres `INTEGER`
  /// stops at 2,147,483,647 — which in cents is **$21,474,836**. This fund is
  /// already at $10M, so half the ceiling, and the failure mode is a write that
  /// errors or silently wraps on a figure nobody would expect to be a limit.
  /// Cents stay exact as a JS `number` up to ~$90 trillion, so the API sends
  /// `Number(...)` and only the column is wide.
  sizeCents BigInt?

  /// When the fund started (owner, 2026-08-24: "name of fund + inception date").
  ///
  /// NULLABLE, and that is not laziness. Fund 1 already exists and this repo is
  /// not allowed to invent a fund figure — an inception date is one. A default
  /// here would write a date nobody supplied into the fund every deal belongs
  /// to. It reads as "not set" until a person sets it.
  ///
  /// A date, not a timestamp: an inception is a calendar day, and storing it
  /// with a time invites a timezone to shift it across midnight.
  inceptionDate DateTime? @db.Date

  createdAt DateTime @default(now())

  deals Deal[]
  roles UserRole[]
}

/// What a person IS on this fund. **Nothing reads it yet.**
///
/// Mirrors `Audience` deliberately — an INVESTOR should see investor-facing
/// documents and a MANAGEMENT user everything — but nothing reads this column
/// to decide anything yet. `src/proxy.ts` still asks one question, "is somebody
/// signed in", and that is the whole authorization model (DECISIONS 2026-08-24).
enum Role {
  MANAGEMENT
  INVESTOR
}

/// A role assignment for ONE Clerk account.
///
/// ## Clerk is the roster; this table is only what Clerk does not know
///
/// The first version of this was a roster of its own — first name, last name,
/// phone — and it was the wrong shape (owner, 2026-08-24: *"can we just read
/// users from clerk?"*). Two lists of people that nothing reconciles will
/// disagree, and the one that gates sign-in is Clerk's, so the other is at best
/// decoration and at worst a lie about who has access.
///
/// So names and phone numbers are read live from Clerk, and this table holds the
/// only two facts Clerk has no opinion about: **which fund, and what role.**
///
/// Keyed by `clerkUserId`, not phone. Phone matching would need normalisation —
/// "+1 555 000 1111" and "5550001111" are the same person and different strings
/// — and getting that wrong on the field that decides what somebody can see is
/// the kind of bug that fails quietly and in the dangerous direction.
///
/// **Nothing reads this yet.** Enforcement is a separate change, deliberately
/// sequenced after this one so the assignments exist before anything depends on
/// them (owner, 2026-08-24).
model UserRole {
  id Int @id @default(autoincrement())

  /// The Clerk user id (`user_...`). Unique: one account, one assignment.
  /// No foreign key — Clerk owns identity and there is no user table to point at.
  clerkUserId String @unique

  fundId Int
  fund   Fund @relation(fields: [fundId], references: [id], onDelete: Restrict)

  role Role

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Clerk user id of whoever made the assignment.
  assignedBy String

  @@index([fundId, role])
}

/// What kind of investment a deal is. **This is what makes the Portfolio's two
/// buckets** — the chart groups deals by it, so a deal without one cannot be
/// plotted and the screen says so rather than dropping it silently.
///
/// Two values because the fund makes two kinds of investment (`FACTS.md`:
/// private equity and private debt). A third is a migration and a conversation
/// about what colour it takes on the chart, since `BucketTone` has two.
enum Instrument {
  PRIVATE_EQUITY
  PRIVATE_CREDIT
}

/// One deal, inside a fund. The unit the owner creates and uploads into.
model Deal {
  /// Sequential and human-quotable, on the owner's ask for "a deal id that we
  /// can pull from later and work off of". Enumerable ids are an acceptable
  /// trade here because every route that serves one is behind Clerk, and the
  /// eventual investor check is on `fundId`, not on guessing a deal number.
  id Int @id @default(autoincrement())

  fundId Int
  fund   Fund @relation(fields: [fundId], references: [id], onDelete: Restrict)

  /// Free text, as typed. Not unique: the same counterparty in two different
  /// years is a real thing, and a uniqueness error on a name is a worse
  /// experience than two rows the owner can tell apart.
  name String

  /// What was invested, in integer cents (owner, 2026-08-24: "investment size").
  /// Nullable — the deal that already exists predates the column.
  ///
  /// **This is the arc length on the Portfolio chart**, and `instrument` below
  /// is which arc. A deal missing either is NAMED on that screen rather than
  /// dropped from it — see `src/lib/portfolio.ts`.
  ///
  /// `BigInt` for the same reason as `Fund.sizeCents`: `INTEGER` cents cap at
  /// $21,474,836, which is not a limit a fund's deal table should carry.
  amountCents BigInt?

  /// Which bucket this deal lands in on the Portfolio chart. Nullable — the
  /// deals that predate the column have none, and a guess here would put real
  /// money in the wrong slice.
  instrument Instrument?

  /// Terms and fees, as free text, shown in the Portfolio drill-down panel.
  ///
  /// **Deliberately free text rather than a typed schema**, for the reason
  /// `FundAllocation`'s `DetailRow` already gives: what a position actually
  /// holds — rate, term, amortisation and accrual for debt; ownership, basis
  /// and marks for equity — is the decision `STATE.md` records as blocked on a
  /// person. Modelling it here to look thorough would mean the real schema
  /// starts by undoing this.
  terms String?
  fees  String?

  /// The investment thesis, as a paragraph (owner, 2026-08-24: "lets add a
  /// 'Why We Like It' modal to the right of the deal info card ... it will be a
  /// paragraph in the investments section").
  ///
  /// Longer cap than `terms` and `fees` (2,000 vs 500) because those are one
  /// line each and this is prose. Still capped: an unbounded TEXT column
  /// feeding a fixed-width panel is how a "paragraph" becomes a pasted memo.
  ///
  /// **INVESTOR-VISIBLE.** Edited in the Deal Room, and shown on the Portfolio
  /// drill-down (owner, 2026-08-24: "it needs to be on portfolio. its for the
  /// investors, a quick snippet of why we like it"). It shipped management-only
  /// for a few hours first; the owner reversed that deliberately, which is the
  /// point — it was decided rather than defaulted.
  ///
  /// **So this column is not a scratchpad.** Whatever is typed here is read by
  /// the investors in that fund. Access is still scoped by fund through
  /// `src/lib/authz.ts` — an investor sees their own fund's deals and no
  /// others — but within a fund there is no draft state and no second copy.
  whyWeLikeIt String?

  /// When it was invested (owner: "investment date (date picker)").
  ///
  /// A `DATE`, not a timestamp, for the same reason as `Fund.inceptionDate`: an
  /// investment lands on a calendar day, and a time component invites a timezone
  /// to move it across midnight.
  investmentDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Clerk user id. No FK — Clerk owns identity and there is no user table.
  createdBy String

  documents DealDocument[]

  @@index([fundId, createdAt])
}

/// One uploaded file. The bytes live in R2 at `key`; this row is everything
/// about the file that is not bytes.
model DealDocument {
  id     Int  @id @default(autoincrement())
  dealId Int
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  audience Audience @default(MANAGEMENT)

  /// The R2 object key:
  ///   management/funds/<fundId>/deals/<dealId>/<uuid>/<filename>
  /// Unique because two rows pointing at one object would make deleting either
  /// one silently break the other.
  key String @unique

  /// The sanitised filename, as stored in the key's last segment.
  filename    String
  /// What the owner typed. The reason this table exists at all.
  description String

  /// Optional grouping, as free text (owner, 2026-08-24: "add a folder that I
  /// can collapse files into").
  ///
  /// A nullable column rather than a `Folder` table, deliberately. A folder here
  /// has no properties of its own — no owner, no description, no permissions,
  /// no nesting — so a table would be a join that buys nothing, and an empty
  /// folder is not a state worth being able to represent. NULL means the
  /// document sits at the top level of the deal, which is where the ones you
  /// want in front of you live.
  ///
  /// The consequence to know: folders are matched by exact string, so
  /// "UCC" and "UCC " are two folders. The upload form offers the deal's
  /// existing names through a datalist to make picking beat typing.
  folder String?

  sizeBytes   Int
  contentType String

  uploadedAt DateTime @default(now())
  /// Clerk user id. Same reasoning as `Deal.createdBy`.
  uploadedBy String

  @@index([dealId, audience])
  @@index([dealId, folder])
}
