# Savoy Capital — environment. Copy to `.env.local` for development and set the
# same variables on the Railway service for the deploy. Never commit real keys:
# `.gitignore` allows this example through and blocks every other `.env*`.

# ── Clerk ──────────────────────────────────────────────────────────────────
# From the Clerk Dashboard → API keys, for the instance backing this
# environment. The publishable key is shipped to the browser (that is what
# NEXT_PUBLIC_ means and it is fine); the secret key must never be.
#
# Both are REQUIRED for the app to build and to boot. A deploy without them
# fails rather than serving the private surface unprotected.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Who may open the portfolio monitor ─────────────────────────────────────
# Comma-separated phone numbers, matched against the VERIFIED numbers on the
# signed-in Clerk account.
#
# PHONE, not email: this Clerk instance identifies users by phone number
# (email is off), so there is no verified email to match on.
#
# Formatting is forgiving — spaces, dashes, parens and a leading + are all
# stripped before comparison — but the COUNTRY CODE IS REQUIRED. "+1 (555)
# 123-4567" and "+15551234567" both work; a bare "5551234567" does not, because
# assuming a country would make the allowlist guess at identity.
#
# This is the real boundary, not a convenience. Clerk answers "is this a
# signed-in user"; whether sign-up is open to the world is a Dashboard setting
# no one can verify by reading this repo.
#
# UNSET MEANS NOBODY GETS IN — including the principals. That is deliberate:
# a forgotten variable should close the door, not open it.
SAVOY_ALLOWED_PHONES=+15555550100,+15555550101
